{
  "manifest_version": 3,
  "name": "Auto Tab Groups",
  "version": "1.0.0",
  "description": "Sorts your tabs into tab groups with Claude, using your own Anthropic API key.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Sort tabs into groups (⌥⇧G)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G", "mac": "Alt+Shift+G" },
      "description": "Sort the current window's ungrouped tabs"
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
